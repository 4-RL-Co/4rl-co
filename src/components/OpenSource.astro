---
// Open Source: the work we do in public. Deliberately NOT in "Work · Companies":
// those are companies (revenue, closed, logo-only). What's here is open and
// anyone can run their own.
// Gume is the section now: the epidemiology placeholder was cut on the owner's
// call (a project that doesn't exist yet gets no row, not even an honest one).
// Claims are checked against the repo (AGPL-3.0, ai/DECISIONS.md, ~300K editions,
// PT-BR, supporter funding: optional, cosmetic, unlocks nothing).
// The visual is the Gume brand frame with the Gume icon over it — deliberately
// LIGHTER blur than the venture plates (4px vs 12) with the grain kept: the
// variation is the point, one treatment everywhere reads as a template.
// Decorative, so alt is empty and the link is hidden from assistive tech:
// gume.club is already in the link list below.
import { Image } from 'astro:assets';
import gumeCover from '../assets/gume-cover.jpg';
import { getLocale, getDict } from '../i18n/index.js';
import { localePathFor } from '../i18n/pages.js';

const locale = getLocale(Astro);
const t = getDict(locale);
const lp = (p) => localePathFor(locale, p);

// The story is an internal link: it stays in the tab and takes the → arrow, so
// it reads as "elsewhere on this site" rather than "off to another site" like
// the three external ones. Placed after gume.club so the order is app, story,
// then the two builder destinations.
const links = [
  { label: 'gume.club', href: 'https://gume.club' },
  { label: t.os.story, href: localePathFor(locale, '/journal/a-reading-log-you-can-fork'), internal: true },
  { label: 'GitHub', href: 'https://github.com/4-RL-Co/gume-club' },
  { label: 'Discussions', href: 'https://github.com/4-RL-Co/gume-club/discussions' },
];
---
<section class="sheetwrap sheetwrap--first" id="open-source" aria-labelledby="os-title">
  <div class="os surface surface--dark sheet">
  <div class="wrap">
    <p class="seclabel reveal"><span class="n">03</span> <span class="slash">/</span> {t.os.label}</p>

    <h2 class="os__title display reveal" id="os-title" data-d="1" set:html={t.os.title} />
    <p class="os__sub reveal" data-d="2" set:html={t.os.sub} />

    <ul class="os__list">
      <li class="os__item reveal" data-d="1">
        <a class="os__visual" href="https://gume.club" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Image
            class="os__visual-img"
            src={gumeCover}
            alt=""
            widths={[420, 840]}
            sizes="(max-width: 760px) 100vw, 420px"
            format="webp"
            quality={78}
            loading="lazy"
            decoding="async"
          />
          <span class="os__visual-grain"></span>
          <img class="os__visual-icon" src="/gume-icon.png" alt="" width="191" height="240" loading="lazy" decoding="async" />
        </a>

        <div class="os__body">
          <p class="os__meta mono">
            <span class="os__live">{t.os.live}</span> <span class="slash">/</span> AGPL-3.0 <span class="slash">/</span> {t.os.langWord}
          </p>
          <h3 class="os__name display">Gume</h3>
          <p class="os__line" set:html={t.os.line} />
          <p class="os__stat mono"><span class="os__num">{t.os.statNum}</span> {t.os.statText}</p>
          <nav class="os__links mono" aria-label="Gume">
            {links.map((l) => (
              <a
                href={l.href}
                target={l.internal ? undefined : '_blank'}
                rel={l.internal ? undefined : 'noopener'}
              >{l.label} <span class="arr">{l.internal ? '→' : '↗'}</span></a>
            ))}
          </nav>
        </div>
      </li>

    </ul>

    <a class="pill os__more reveal" href={lp("/open-source")}>{t.os.more} <span class="arr">→</span></a>
  </div>
  </div>
</section>

<style>
  /* A sheet now, not a full-bleed cut: the padding is the card's own interior,
     so it no longer needs the oversized top that the hard paper-to-black cut
     used to ask for. */
  .os{ padding-top:clamp(56px,8vh,96px); padding-bottom:clamp(48px,6vh,80px); }

  .os__title{
    text-transform:uppercase; font-weight:700;
    font-size:clamp(22px,3vw,42px); letter-spacing:-.03em; line-height:1.02;
    max-width:22ch;
  }
  .os__sub{
    margin-top:clamp(14px,2vh,22px);
    color:var(--ink-muted); font-size:clamp(14px,1.35vw,17px); max-width:70ch;
  }
  .os__code{
    font-family:var(--font-mono); font-size:.88em;
    color:var(--ink); background:var(--bg-elev);
    border:1px solid var(--line); border-radius:3px; padding:1px 6px;
  }

  .os__list{ list-style:none; margin-top:clamp(32px,4.5vh,56px); }
  .os__item{
    display:grid; grid-template-columns:minmax(0,420px) 1fr;
    align-items:start; gap:clamp(20px,3vw,48px);
    padding:clamp(22px,2.8vw,34px) 0; border-top:1px solid var(--line);
  }
  .os__list li:last-child{ border-bottom:1px solid var(--line); }

  /* The Gume frame: 4px of blur where the plates run 12 — the section earns
     its own texture — with the grain doubled over it and the Gume icon
     centered. :global on the img, the lesson written in ai/DECISIONS.md:
     scoped styles never reach inside <Image>. */
  .os__visual{
    position:relative; display:block; overflow:hidden;
    border:1px solid var(--line); border-radius:var(--radius-lg);
    background:var(--grade-umber);
    transition:border-color .3s var(--ease);
  }
  .os__visual:hover{ border-color:var(--accent); }
  .os__visual :global(.os__visual-img){
    display:block; width:100%; height:auto;
    filter:blur(4px) saturate(1.05);
    transform:scale(1.04);
  }
  .os__visual-grain{
    position:absolute; inset:0; pointer-events:none;
    background:var(--grain), var(--grain), linear-gradient(180deg, transparent 50%, rgba(0,0,0,.35) 100%);
  }
  .os__visual-icon{
    position:absolute; top:50%; left:50%;
    width:auto; height:clamp(48px,6vw,76px);
    transform:translate(-50%,-50%);
    filter:drop-shadow(0 6px 22px rgba(0,0,0,.5));
  }

  .os__meta{ color:var(--ink-muted); }
  .os__live{ color:var(--accent); }
  .os__name{
    font-size:clamp(26px,3.4vw,52px); letter-spacing:-.04em; line-height:.96;
    text-transform:uppercase; margin-top:10px;
  }
  .os__line{
    margin-top:14px; color:var(--ink-muted);
    font-size:clamp(14px,1.35vw,17px); max-width:52ch;
  }
  .os__em{ color:var(--ink); font-weight:600; }

  .os__stat{ margin-top:18px; color:var(--ink-muted); }
  .os__num{ color:var(--ink); font-size:1.35em; letter-spacing:-.02em; }

  .os__links{ display:flex; flex-wrap:wrap; gap:clamp(14px,2vw,28px); margin-top:20px; }
  .os__links a{ color:var(--ink); transition:color .25s var(--ease); }
  .os__links a:hover{ color:var(--accent); }
  .os__links .arr{ color:var(--accent); }
  .os__links a:hover .arr{ transform:translate(2px,-2px); }

  .os__more{ margin-top:clamp(24px,4vh,40px); }

  @media (max-width:760px){
    .os__item{ grid-template-columns:1fr; gap:18px; }
  }
</style>
