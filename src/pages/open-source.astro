---
// /open-source — the public work at page length. The home section stays the
// teaser; this page carries the full argument: Gume as the live proof, the
// epidemiology work as the honest in-progress, and the practice itself, the
// decision log, as the thing that makes "open" mean something here.
//
// Claims are the same ones the home section already checks against the repo:
// AGPL-3.0, ~300K editions, PT-BR, supporter funding optional and cosmetic.
// Nothing new is promised on this page.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import gumeCover from '../assets/gume-cover.jpg';
import { getLocale, homePath } from '../i18n/index.js';
import { getPages, localePathFor } from '../i18n/pages.js';

const locale = getLocale(Astro);
const P = getPages(locale);
const lp = (p) => localePathFor(locale, p);
const O = P.osp;

const site = 'https://www.4real.ventures';
const title = O?.title ?? 'Open Source · 4/RL Co.';
const description = O?.desc ??
  'The work 4/RL builds in public: Gume, an open reading log in Portuguese under AGPL-3.0, and a decision log where every choice carries its reason.';

const gumeLinks = [
  { label: 'gume.club', href: 'https://gume.club' },
  { label: O?.story ?? 'The story', href: localePathFor(locale, '/journal/a-reading-log-you-can-fork'), internal: true },
  { label: 'GitHub', href: 'https://github.com/4-RL-Co/gume-club' },
  { label: 'Discussions', href: 'https://github.com/4-RL-Co/gume-club/discussions' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${site}/open-source/#webpage`,
    url: `${site}/open-source/`,
    name: title,
    description,
    isPartOf: { '@id': `${site}/#website` },
    about: { '@id': `${site}/#organization` },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${site}/open-source/#gume`,
    name: 'Gume',
    url: 'https://gume.club',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    inLanguage: 'pt-BR',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    creator: { '@id': `${site}/#organization` },
    codeRepository: 'https://github.com/4-RL-Co/gume-club',
  },
];
---
<Base title={title} description={description} twitterDesc="The work 4/RL builds in public." jsonLd={jsonLd}>
  <Nav />
  <main class="osp">
    <header class="surface surface--dark surface--deep osp__head">
      <div class="wrap">
        <p class="osp__kicker mono reveal">{O?.kicker ?? 'Open Source'} <span class="slash">/</span> AGPL-3.0</p>
        <h1 class="osp__title display">
          <span class="tline"><span class="tline__in" style="--tl:0" set:html={O?.h1?.[0] ?? 'The code ships'} /></span>
          <span class="tline"><span class="tline__in" style="--tl:1" set:html={O?.h1?.[1] ?? 'with its <span class="serif">reasons</span><span class="slash">.</span>'} /></span>
        </h1>
        <p class="osp__lede reveal" data-d="2">
          {O?.lede ?? "Most of the studio's work is companies, and you see the result. The work on this page is different: the code, the schema and the decision log are public, and anyone can read them, fork them, or run their own."}
        </p>
      </div>
    </header>

    <section class="surface surface--dark surface--deep osp__gume" aria-labelledby="osp-gume">
      <div class="wrap">
        <p class="seclabel reveal"><span class="n">01</span> <span class="slash">/</span> Gume <span class="osp__live">{O?.live ?? 'Live'}</span></p>
        <div class="osp__gume-grid">
          <div class="reveal" data-d="1">
            <h2 class="osp__h2 display" id="osp-gume" set:html={O?.gumeTitle ?? 'A reading log anyone can <span class="hl">fork</span><span class="slash">.</span>'} />
            <p class="osp__body">
              {O?.gumeP1 ?? 'Gume is a reading log, Brazilian and in Portuguese by choice. It will be paid for by supporters, and that support stays optional and cosmetic: a badge on the profile, nothing more. Paying unlocks nothing, so everyone reads the same Gume. The code is AGPL-3.0, and anyone can take it and run their own; that exit is the point.'}
            </p>
            <p class="osp__body">
              {O?.gumeP2 ?? 'It is built with the people who use it. Fix a wrong cover, open an issue, send a pull request: the catalog holds roughly 300 thousand Portuguese-language editions, and it gets better in public.'}
            </p>
            <p class="osp__stat mono"><span class="osp__num">{O?.statNum ?? '~300K'}</span> {O?.statText ?? 'Portuguese-language editions in the catalog'}</p>
            <nav class="osp__links mono" aria-label="Gume">
              {gumeLinks.map((l) => (
                <a
                  href={l.href}
                  target={l.internal ? undefined : '_blank'}
                  rel={l.internal ? undefined : 'noopener'}
                >{l.label} <span class="arr">{l.internal ? '→' : '↗'}</span></a>
              ))}
            </nav>
          </div>
          <a class="osp__visual reveal" data-d="2" href="https://gume.club" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <Image
              class="osp__visual-img"
              src={gumeCover}
              alt=""
              widths={[520, 1040]}
              sizes="(max-width: 860px) 100vw, 520px"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
            <span class="osp__visual-grain"></span>
            <img class="osp__visual-icon" src="/gume-icon.png" alt="" width="191" height="240" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <section class="surface surface--dark surface--deep osp__practice" aria-labelledby="osp-practice">
      <div class="wrap">
        <p class="seclabel reveal"><span class="n">02</span> <span class="slash">/</span> {O?.practiceLabel ?? 'The practice'}</p>
        <h2 class="osp__h2 display reveal" id="osp-practice" set:html={O?.practiceTitle ?? 'Every choice carries its <span class="serif">reason</span><span class="slash">.</span>'} />
        <div class="osp__practice-grid">
          <p class="osp__body reveal" data-d="1" set:html={O?.practiceP1 ?? 'Open source here means more than a license. Each public project keeps a decision log, <code class="osp__code">ai/DECISIONS.md</code>, where every choice is written down with its reason, including the ones we got wrong and reversed. The site you are reading keeps one too.'} />
          <p class="osp__body reveal" data-d="2">
            {O?.practiceP2 ?? 'The log is what makes a fork honest work instead of archaeology: you can disagree with a decision and know exactly what you are disagreeing with. It also keeps us honest, because a reason you have to write down is a reason you have to have.'}
          </p>
        </div>
        <a class="pill pill--solid osp__gh reveal" data-d="3" href="https://github.com/4-RL-Co" target="_blank" rel="noopener">
          {O?.gh ?? '4/RL on GitHub'} <span class="arr">↗</span>
        </a>
      </div>
    </section>

    <section class="surface surface--dark surface--deep osp__close">
      <div class="wrap osp__close-row">
        <p class="osp__close-line reveal">{O?.closeLine ?? 'Something here you want to build on?'}</p>
        <a class="pill pill--solid reveal" data-d="1" href={`${homePath(locale)}#contact`}>{P.chrome.talk} <span class="slash">/</span></a>
      </div>
    </section>
  </main>
</Base>

<style>
  .osp__head{ padding-top:calc(var(--nav-h) + clamp(40px,8vh,90px)); padding-bottom:clamp(48px,8vh,100px); }
  .osp__kicker{ margin-bottom:clamp(20px,3vh,36px); }
  .osp__title{
    text-transform:uppercase;
    font-size:clamp(36px,7.6vw,124px); letter-spacing:-.05em; line-height:.93;
  }
  .osp__lede{
    margin-top:clamp(20px,3.5vh,36px);
    color:var(--ink-muted); font-size:clamp(16px,1.7vw,22px); max-width:56ch;
  }

  .osp__h2{
    text-transform:uppercase;
    font-size:clamp(26px,4.2vw,64px); letter-spacing:-.04em; line-height:1;
    max-width:20ch;
  }
  .osp__body{ margin-top:clamp(16px,2.4vh,24px); color:var(--ink-muted); font-size:clamp(15px,1.5vw,18px); line-height:1.6; max-width:58ch; }
  .osp__inline{ color:var(--ink); border-bottom:1px solid var(--line); transition:border-color .25s var(--ease); }
  .osp__inline:hover{ border-color:var(--ink); }

  .osp__live{
    color:var(--accent); margin-left:6px;
  }

  .osp__gume{ padding:clamp(64px,10vh,130px) 0 clamp(48px,8vh,90px); }
  .osp__gume-grid{
    display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,520px);
    gap:clamp(28px,5vw,90px); align-items:start;
  }
  .osp__stat{ margin-top:clamp(20px,3vh,32px); color:var(--ink-muted); }
  .osp__num{ color:var(--ink); font-size:1.35em; letter-spacing:-.02em; }
  .osp__links{ display:flex; flex-wrap:wrap; gap:clamp(14px,2vw,28px); margin-top:22px; }
  .osp__links a{ color:var(--ink); transition:color .25s var(--ease); }
  .osp__links a:hover{ color:var(--accent); }
  .osp__links .arr{ color:var(--accent); }
  /* Same Gume frame as the home section: 4px blur (the plates run 12), grain
     doubled, the Gume icon centered. :global because <Image> is a component
     and scoped styles stop at its border. */
  .osp__visual{
    position:relative; display:block; overflow:hidden;
    border:1px solid var(--line); border-radius:var(--radius-lg);
    background:var(--grade-umber);
    transition:border-color .3s var(--ease);
  }
  .osp__visual:hover{ border-color:var(--accent); }
  .osp__visual :global(.osp__visual-img){
    display:block; width:100%; height:auto;
    filter:blur(4px) saturate(1.05);
    transform:scale(1.04);
  }
  .osp__visual-grain{
    position:absolute; inset:0; pointer-events:none;
    background:var(--grain), var(--grain), linear-gradient(180deg, transparent 50%, rgba(0,0,0,.35) 100%);
  }
  .osp__visual-icon{
    position:absolute; top:50%; left:50%;
    width:auto; height:clamp(56px,7vw,88px);
    transform:translate(-50%,-50%);
    filter:drop-shadow(0 6px 22px rgba(0,0,0,.5));
  }

  .osp__practice{ padding:clamp(64px,10vh,130px) 0; }
  .osp__practice-grid{
    display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    gap:clamp(20px,4vw,72px); margin-top:clamp(8px,1.5vh,16px);
  }
  .osp__code{
    font-family:var(--font-mono); font-size:.88em;
    color:var(--ink); background:var(--bg-elev);
    border:1px solid var(--line); border-radius:3px; padding:1px 6px;
  }
  .osp__gh{ margin-top:clamp(28px,4vh,44px); }

  .osp__close{ padding:clamp(48px,8vh,90px) 0; }
  .osp__close-row{
    display:flex; align-items:center; justify-content:space-between;
    gap:clamp(20px,4vw,48px); flex-wrap:wrap;
  }
  .osp__close-line{ color:var(--ink-muted); font-size:clamp(15px,1.6vw,20px); }

  @media (max-width:860px){
    .osp__gume-grid, .osp__practice-grid{ grid-template-columns:1fr; }
  }
</style>
