---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getLocale, LOCALES, LOCALE_META, homePath } from '../i18n/index.js';

const {
  title = '4/RL Co. · Independent AI Venture Studio',
  description = 'We improve the world with AI. For real. An independent AI venture studio building and operating ventures across influence, science, applied AI and cinema.',
  twitterDesc = 'We improve the world with AI. For real.',
  jsonLd,
  // Colour of the browser chrome on mobile. It has to match whatever surface
  // the page actually STARTS on, or the bar and the top of the page disagree:
  // the home page opens on paper, every other page still opens on near-black.
  themeColor = '#0A0A0B',
} = Astro.props;
// SITE_URL — the canonical 4/RL domain (used for absolute OG/Twitter image URLs).
const site = 'https://www.4real.ventures';
// Public Cloudflare Web Analytics beacon token (kept in an env var, not in source).
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
// Microsoft Clarity project id (public tag; kept in an env var, not in source).
const clarityId = import.meta.env.PUBLIC_CLARITY_ID;
// Google Analytics 4 measurement id (public; env-kept like the two above).
const gaId = import.meta.env.PUBLIC_GA_ID;

const isHome = Astro.url.pathname === '/';
// The locale rides the route (Astro i18n); non-localized pages are English.
const locale = getLocale(Astro);
// Every route exists in every locale now, so every page carries the full
// alternate family. Strip the locale prefix to find the shared suffix.
const normalized = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const prefix = LOCALES.find((l) => l !== 'en' && normalized.startsWith(`/${l}/`));
const suffix = prefix ? normalized.slice(prefix.length + 1) : normalized;
const altPath = (l) => (l === 'en' ? suffix : `/${l}${suffix}`);
// Per-page canonical / OG url (was hardcoded to the homepage on every page).
const canonicalURL = site + Astro.url.pathname;
// Brand social profiles — used for schema.org sameAs (entity linking).
const social = [
  'https://www.linkedin.com/company/4rl-co/',
  'https://github.com/4-RL-Co',
  'https://t.me/olegas4real',
];
// Homepage structured data — Organization, WebSite and WebPage emitted as
// separate top-level JSON-LD blocks (not wrapped in @graph). Cross-links via
// @id still resolve across blocks, and a top-level Organization node is what
// crawlers/audits look for when reading the company name + logo.
const orgNode = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: '4/RL Co.',
  alternateName: '4RL',
  url: site,
  logo: `${site}/favicon-512.png`,
  image: `${site}/og-image.png`,
  description,
  foundingLocation: { '@type': 'Place', name: 'São Paulo, BR' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'olegas@4real.ventures',
    telephone: '+5511933279420',
    areaServed: 'BR',
    availableLanguage: ['Portuguese', 'English'],
  },
  founder: { '@type': 'Person', name: 'Gabriel Olegário', sameAs: social },
  sameAs: social,
  subOrganization: [
    { '@type': 'Organization', name: 'Smart Social', url: 'https://smtsocial.com.br/' },
    { '@type': 'Organization', name: 'LabEpi', url: 'https://laboratoriodeepidemiologia.com/' },
    { '@type': 'Organization', name: 'M1m1c Box', url: 'https://www.youtube.com/@m1m1cbox' },
  ],
};
const websiteNode = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: '4/RL Co.',
  description,
  publisher: { '@id': `${site}/#organization` },
  inLanguage: 'en',
};
const webpageNode = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description,
  isPartOf: { '@id': `${site}/#website` },
  about: { '@id': `${site}/#organization` },
  primaryImageOfPage: `${site}/og-image.png`,
  inLanguage: 'en',
};
const homeSchemas = [orgNode, websiteNode, webpageNode];
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {/* CSP fallback for hosts that can't set headers (e.g. GitHub Pages). Prod only,
     so it doesn't interfere with the dev server's HMR websocket. On Vercel/Netlify
     the header version in vercel.json / _headers also applies. */}
  {import.meta.env.PROD && (
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://*.clarity.ms https://www.google-analytics.com https://*.google-analytics.com; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.clarity.ms https://*.clarity.ms https://www.googletagmanager.com; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.clarity.ms https://c.bing.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests"
    />
  )}
  {/* Microsoft Clarity — loads early; project id comes from env, never hardcoded. */}
  {clarityId && (
    <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${clarityId}");`} />
  )}
  {/* Google Analytics 4 (gtag.js). Loader + config, both is:inline so Astro
     leaves them untouched; measurement id comes from env, never hardcoded.
     googletagmanager.com is in script-src, google-analytics.com in
     connect-src/img-src (the /g/collect beacon, region variants included). */}
  {gaId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`} />
    </>
  )}
  <!-- before-paint flags: reveal animation opt-in + preloader once-per-session -->
  <script is:inline>
    (function () {
      var h = document.documentElement;
      try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) h.classList.add('js'); } catch (e) {}
      try { if (sessionStorage.getItem('4rl_pre')) h.classList.add('preloaded'); } catch (e) {}
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content={themeColor} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
  <link rel="dns-prefetch" href="https://www.clarity.ms" />
  {gaId && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}
  <link rel="icon" href={site + '/favicon.ico'} sizes="any" />
  <link rel="shortcut icon" href={site + '/favicon.ico'} />
  <link rel="icon" type="image/png" sizes="512x512" href={site + '/favicon-512.png'} />
  <link rel="icon" type="image/png" sizes="32x32" href={site + '/favicon-32.png'} />
  <link rel="icon" type="image/svg+xml" href={site + '/4rl-favicon.svg'} />
  <link rel="apple-touch-icon" sizes="180x180" href={site + '/apple-touch-icon-180.png'} />
  <link rel="manifest" href="/site.webmanifest" />

  {/* the language family: every home points at every home, English is the
      x-default because English is the site's canonical voice */}
  {LOCALES.map((l) => (
    <link rel="alternate" hreflang={l === 'zh' ? 'zh-CN' : l} href={site + altPath(l)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={site + suffix} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content={LOCALE_META[locale].og} />
  <meta property="og:site_name" content="4/RL Co." />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={site + '/og-image.png'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={twitterDesc} />
  <meta name="twitter:image" content={site + '/og-image.png'} />

  {/* structured data: Organization on the homepage, page-specific schema elsewhere */}
  {isHome && homeSchemas.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  {/* The mark is inlined, not <img src>. As an external SVG it was the LCP
     element and waited on its own request to paint (a 650ms render delay in
     the field). Inline, it paints with the first frame of HTML. */}
  <div class="preloader" id="preloader" aria-hidden="true">
    <svg class="preloader__mark" viewBox="0 0 100 100" width="60" height="60" role="img" aria-label="4/RL Co.">
      <mask id="preCut">
        <rect x="10" y="10" width="80" height="80" rx="16" fill="#fff" />
        <path d="M60 17 L73 17 L40 83 L27 83 Z" fill="#000" />
      </mask>
      <rect x="10" y="10" width="80" height="80" rx="16" fill="#C6FF3A" mask="url(#preCut)" />
    </svg>
  </div>

  <div class="cursor" id="cursor" aria-hidden="true"></div>
  <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>

  <slot />

  {cfToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfToken}"}`}></script>
  )}

  {/* Vercel first-party, both same-origin under /_vercel/* so 'self' in the CSP
     covers script and beacon with no policy change. Analytics = page views;
     Speed Insights = field Core Web Vitals (the LCP/CLS/INP of real visits,
     which is what validates the perf work). Both still need Web Analytics /
     Speed Insights toggled on in the Vercel project dashboard to collect. */}
  <Analytics />
  <SpeedInsights />

  <script>
    /* ---- Scroll reveals: never leave content hidden ---- */
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = Array.from(document.querySelectorAll('.reveal'));
    const showAll = () => items.forEach((el) => el.classList.add('in'));
    if (reduce || !('IntersectionObserver' in window)) {
      showAll();
    } else {
      const vh = () => window.innerHeight || document.documentElement.clientHeight;
      // reveal anything already in view immediately (fast, no wait)
      items.forEach((el) => { const r = el.getBoundingClientRect(); if (r.top < vh() * 0.92) el.classList.add('in'); });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0, rootMargin: '0px 0px -6% 0px' });
      items.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
      // safety net: nothing stays hidden longer than 1.2s
      setTimeout(showAll, 1200);
    }

    /* ---- Marquees: one shared speed, whatever the content ----
       Duration comes from each track's own width so every strip moves at the
       same px/s. Hardcoding one duration made the wider strip race the narrower
       one. The track holds 3 copies and the keyframe travels exactly 1 of them,
       so the distance per cycle is scrollWidth / 3.
       If this never runs, the CSS fallback duration still animates. */
    const MARQUEE_PX_PER_SEC = 26;
    const timeMarquees = () => {
      document.querySelectorAll('.marquee__track').forEach((track) => {
        const perCycle = track.scrollWidth / 3;
        if (!perCycle) return;
        track.style.setProperty('--marquee-dur', (perCycle / MARQUEE_PX_PER_SEC).toFixed(2) + 's');
      });
    };
    if (!reduce) {
      timeMarquees();
      // Webfonts land after first paint and change the text strip's width.
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(timeMarquees);
      let t;
      addEventListener('resize', () => { clearTimeout(t); t = setTimeout(timeMarquees, 200); });
    }

    /* ---- Preloader: mark hold, then a "/" wipe. Once per session. Non-blocking. ---- */
    const pre = document.getElementById('preloader');
    if (pre) {
      if (document.documentElement.classList.contains('preloaded')) {
        pre.remove();                              // already shown this session
      } else {
        try { sessionStorage.setItem('4rl_pre', '1'); } catch (e) {}
        const gone = () => pre.remove();
        if (reduce) { pre.classList.add('fade'); setTimeout(gone, 160); }
        else { setTimeout(() => { pre.classList.add('wipe'); setTimeout(gone, 480); }, 240); }
      }
    }

    /* ---- Custom cursor (desktop pointer only) ---- */
    const fine = window.matchMedia('(hover:hover) and (pointer:fine)').matches;
    if (fine && !reduce) {
      const root = document.documentElement;
      root.classList.add('hide-cursor'); /* hide OS cursor */
      const c = document.getElementById('cursor');
      const d = document.getElementById('cursorDot');
      let cx = innerWidth / 2, cy = innerHeight / 2, dx = cx, dy = cy;
      let cursorPaused = false;
      const setCustomCursor = (enabled) => {
        cursorPaused = !enabled;
        root.classList.toggle('hide-cursor', enabled);
        c.style.opacity = enabled ? c.style.opacity : '0';
        d.style.opacity = enabled ? d.style.opacity : '0';
      };
      addEventListener('pointermove', (e) => {
        if (cursorPaused) return;
        cx = e.clientX; cy = e.clientY;
        d.style.transform = `translate(${cx}px,${cy}px) translate(-50%,-50%)`;
        c.style.opacity = '1'; d.style.opacity = '1';
      }, { passive: true });
      /* The ring is a difference blend tuned for near-black. Over paper that
         same blend turns the lime border violet, so the cursor has to know
         which surface it is currently over. Hit-testing is the only reliable
         answer (sections interleave and the ring is fixed-position), but
         elementFromPoint forces layout, so it runs on every 6th frame of the
         loop that is already running rather than on every pointermove. */
      let onLight = false, tick = 0;
      const syncSurface = () => {
        const el = document.elementFromPoint(cx, cy);
        const light = !!(el && el.closest && el.closest('.surface--light'));
        if (light !== onLight) { onLight = light; root.classList.toggle('cursor-light', light); }
      };
      (function loop() {
        dx += (cx - dx) * 0.18; dy += (cy - dy) * 0.18;
        c.style.transform = `translate(${dx}px,${dy}px) translate(-50%,-50%)`;
        if ((tick = (tick + 1) % 6) === 0) syncSurface();
        requestAnimationFrame(loop);
      })();
      const hover = (on) => () => c.classList.toggle('is-hover', on);
      document.querySelectorAll('a,button,[data-cursor]').forEach((el) => {
        el.addEventListener('pointerenter', hover(true));
        el.addEventListener('pointerleave', hover(false));
      });
      const syncAeoCursor = () => {
        const overlay = document.querySelector('.aeo-overlay');
        const open = overlay && getComputedStyle(overlay).display !== 'none' && overlay.getBoundingClientRect().width > 0;
        setCustomCursor(!open);
      };
      const mo = new MutationObserver(syncAeoCursor);
      mo.observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'style', 'hidden'] });
      addEventListener('keydown', syncAeoCursor);
      addEventListener('click', () => requestAnimationFrame(syncAeoCursor));
      syncAeoCursor();
    }
  </script>
</body>
</html>
